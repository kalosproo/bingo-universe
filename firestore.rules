rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant(room) { return signedIn() && request.auth.uid in room.data.participants; }
    function validSettings(s) { return s is map && s.size >= 3 && s.gridSize in [3,5] && s.winPattern in ['line','fourCorners','blackout'] && s.maxPlayers is int && s.maxPlayers >= 2 && s.maxPlayers <= 50 && s.allowFreeSpace is bool; }
    function validRoom() { return request.resource.data.keys().hasAll(['code','hostId','settings','participants','status','createdAt','updatedAt']) && request.resource.data.code.matches('^[A-Z0-9]{6}$') && request.resource.data.hostId == request.auth.uid && validSettings(request.resource.data.settings) && request.resource.data.status in ['lobby','playing','finished']; }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && validRoom();
      allow update: if isParticipant(resource) && validSettings(request.resource.data.settings) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['settings','participants','status','calledNumbers','winnerIds','updatedAt']);
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
      match /messages/{messageId} {
        allow read: if isParticipant(get(/databases/$(database)/documents/rooms/$(roomId)));
        allow create: if isParticipant(get(/databases/$(database)/documents/rooms/$(roomId))) && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 240;
        allow update, delete: if false;
      }
      match /boards/{uid} {
        allow read: if isParticipant(get(/databases/$(database)/documents/rooms/$(roomId)));
        allow create, update: if signedIn() && uid == request.auth.uid;
      }
    }
  }
}
